# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemma-4-26b-a4b-it (fast, default) or gemma-4-31b-it
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_TEMPERATURE=0.2

# Local alternative (no key, offline): run `ollama serve`, `ollama pull gemma4:e4b`,
# then pick "ollama:gemma4:e4b" in the UI or set GEMMA_MODEL=ollama:gemma4:e4b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b
